generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Employees
model Employee {
  id             String  @id @db.VarChar(20)
  name           String
  role           String
  phone          String
  pin            String  @db.VarChar(4)
  status         String  @default("Active") @db.VarChar(20)
  lastLogin      String  @map("last_login")

  payMethod      String  @default("Commission") @map("pay_method") @db.VarChar(30)
  rate           Int?
  commissionRate Int?    @map("commission_rate")

  @@map("employees")
}

// Inventory 
model InventoryItem {
  sku      String @id @db.VarChar(20)
  name     String
  fits     String
  category String @default("Uncategorized")
  cost     Int
  price    Int
  qty      Int
  low      Int
  added    String @db.VarChar(20)

  @@index([category])
  @@map("inventory_items")
}

// Labor catalog 
model LaborCharge {
  code     String @id @db.VarChar(20)
  name     String
  category String
  price    Int

  @@map("labor_charges")
}

// Job cards 
model JobCard {
  id String @id @db.VarChar(20)

  registration String @db.VarChar(20)
  vehicle      Vehicle @relation(fields: [registration], references: [registration], onDelete: Restrict)

  mechanic String
  stage    String @default("diagnostics") @db.VarChar(20)

  startedAt   BigInt  @map("started_at")
  completedAt BigInt? @map("completed_at")

  mileageAtStart Int? @map("mileage_at_start")
  mileageAtEnd   Int? @map("mileage_at_end")

  faults           String  @db.Text
  diagnosisNotes   String? @map("diagnosis_notes") @db.Text
  diagnosisFindings Json?  @map("diagnosis_findings")

  lines JobLine[]

  @@index([registration])
  @@index([stage])
  @@index([completedAt])
  @@map("job_cards")
}

model JobLine {
  id Int @id @default(autoincrement())

  jobId String  @map("job_id") @db.VarChar(20)
  job   JobCard @relation(fields: [jobId], references: [id], onDelete: Cascade)

  type     String @db.VarChar(10)
  name     String
  price    Int
  sku      String?
  position Int    @default(0)

  @@index([jobId])
  @@map("job_lines")
}

// Vehicles 
model Vehicle {
  registration String @id @db.VarChar(20)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  model   String
  year    Int?
  color   String?
  mileage Int @default(0)
  fuel    Int?
  health  Int?

  lastServiceKm     Int? @map("last_service_km")
  serviceIntervalKm Int? @map("service_interval_km")
  nextServiceKm     Int? @map("next_service_km")

  jobCards JobCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("vehicles")
}

// Customers
model Customer {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?

  vehicles Vehicle[]

  notifications CustomerNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@map("customers")
}

// Customer notifications 
model CustomerNotification {
  id         Int      @id @default(autoincrement())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type       String   @db.VarChar(20)
  read       Boolean  @default(false)
  time       String   @db.VarChar(40)
  title      String
  body       String   @db.Text

  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([customerId, read])
  @@map("customer_notifications")
}

// Payroll pay periods — one record per employee per calendar month
model PayPeriod {
  id         Int      @id @default(autoincrement())

  employeeId String   @map("employee_id") @db.VarChar(20)
  year       Int
  month      Int      // 1–12

  paid       Boolean  @default(false)
  paidAt     BigInt?  @map("paid_at")   // epoch ms when marked paid

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@map("pay_periods")
}

// Business settings 
model BusinessSettings {
  id      Int    @id @default(1)
  name    String
  kra     String @db.VarChar(20)
  vatRate Int    @map("vat_rate")

  @@map("business_settings")
}